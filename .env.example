# Variables de BUILD (préfixe VITE_ = exposées au navigateur).
# Ne jamais y mettre de secret : tout VITE_* finit dans le bundle public.
VITE_API_BASE_URL=https://fakestoreapi.com
VITE_OTEL_EXPORTER_URL=
VITE_ENVIRONMENT=local
VITE_APP_VERSION=dev

# Variables de RUNTIME du conteneur (lues par docker/entrypoint.sh).
APP_API_BASE_URL=https://fakestoreapi.com
APP_OTEL_EXPORTER_URL=http://otel-collector:4318/v1/traces
APP_ENVIRONMENT=local
APP_VERSION=dev
